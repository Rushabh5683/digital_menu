# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# PostgreSQL — Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/digital_menu?schema=public"

# Auth (local development)
# Use a long random string in any shared/staging environment.
JWT_SECRET="dev-only-change-me-digital-menu-jwt"
JWT_EXPIRES_IN="8h"
AUTH_COOKIE_NAME="dm_session"
COOKIE_SECURE=false

# Frontend (apps/web/.env)
# VITE_API_BASE_URL=
# Leave empty to use Vite proxy (/api → http://localhost:4000) during local dev.
# Set to http://localhost:4000 if you call the API without the proxy.
#
# Staging / friend-test (split hosts):
# VITE_API_BASE_URL=https://your-api.up.railway.app
# API CORS_ORIGIN / PUBLIC_APP_URL = https://your-app.vercel.app
# COOKIE_SECURE=true  (enables SameSite=None for cross-site login cookies)
