generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  RESTAURANT_ADMIN
  RESTAURANT_CAPTAIN
}

enum RestaurantStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum OrderStatus {
  PLACED
  ACCEPTED
  PREPARING
  READY
  COMPLETED
  REJECTED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  UPI_GPAY
  UPI_PHONEPE
  UPI_OTHER
  OTHER
  PART
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  restaurantId String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dayEndCloses DayEndClose[]
  dayEndReopens DayEndReopenLog[] @relation("DayEndReopens")
  appreciationShares OrderAppreciationShare[]
  cancelledOrders Order[] @relation("OrderCancellations")
  refreshTokens RefreshToken[]

  @@index([restaurantId])
  @@index([role])
}

/// Long-lived refresh session (hashed). Rotated on each /auth/refresh.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  replacedById String?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Restaurant {
  id           String           @id @default(cuid())
  name         String
  slug         String           @unique
  description  String?
  email        String?
  phone        String?
  address      String?
  logoUrl      String?
  brandTagline String?
  brandAccent  String?
  /// Printable table QR card preset: forest | ivory | midnight | terracotta
  qrCardTheme  String           @default("forest")
  /// Restaurant-wide GST (PetPooja-style default). Applied tax-exclusive on subtotal.
  gstEnabled   Boolean          @default(false)
  gstin        String?
  fssaiLicense String?
  billThanksMessage String?     @default("Thanks for visiting us. Drive safe. Stay healthy.")
  cgstRate     Decimal          @default(0) @db.Decimal(5, 2)
  sgstRate     Decimal          @default(0) @db.Decimal(5, 2)
  status       RestaurantStatus @default(PENDING)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  menus           Menu[]
  sessions        Session[]
  analyticsEvents AnalyticsEvent[]
  admins          User[]
  orders          Order[]
  tables          DiningTable[]
  dayEndCloses    DayEndClose[]
  dayEndReopens   DayEndReopenLog[]

  @@index([status])
  @@index([createdAt])
}

model DiningTable {
  id            String    @id @default(cuid())
  restaurantId  String
  tableNumber   Int
  name          String?
  capacity      Int?
  isActive      Boolean   @default(true)
  qrGeneratedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  sessions   Session[]
  orders     Order[]

  @@unique([restaurantId, tableNumber])
  @@index([restaurantId])
  @@index([restaurantId, isActive])
  @@map("Table")
}

/// PetPooja-style business-day closeout. One close per restaurant per calendar day.
model DayEndClose {
  id             String   @id @default(cuid())
  restaurantId   String
  /// Local business date as YYYY-MM-DD
  businessDate   String
  closedAt       DateTime @default(now())
  closedByUserId String?
  note           String?
  /// Snapshot of sales summary at close time
  summaryJson    Json
  /// Temporary edit window after admin password unlock. Null = fully locked.
  unlockedUntil  DateTime?
  unlockedByUserId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  closedBy   User?      @relation(fields: [closedByUserId], references: [id], onDelete: SetNull)

  @@unique([restaurantId, businessDate])
  @@index([restaurantId, closedAt])
}

/// Audit when a closed day is unlocked (password) for corrections.
model DayEndReopenLog {
  id               String   @id @default(cuid())
  restaurantId     String
  businessDate     String
  reopenedByUserId String?
  reason           String?
  createdAt        DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  reopenedBy User?      @relation("DayEndReopens", fields: [reopenedByUserId], references: [id], onDelete: SetNull)

  @@index([restaurantId, businessDate])
  @@index([createdAt])
}

model Order {
  id             String         @id @default(cuid())
  restaurantId   String
  tableId        String
  sessionId      String?
  orderNumber    String
  status         OrderStatus    @default(PLACED)
  subtotal       Decimal        @db.Decimal(10, 2)
  /// Snapshot of restaurant CGST/SGST rates when totals were last calculated
  cgstRate       Decimal        @default(0) @db.Decimal(5, 2)
  sgstRate       Decimal        @default(0) @db.Decimal(5, 2)
  cgstAmount     Decimal        @default(0) @db.Decimal(10, 2)
  sgstAmount     Decimal        @default(0) @db.Decimal(10, 2)
  taxAmount      Decimal        @default(0) @db.Decimal(10, 2)
  roundOffAmount Decimal        @default(0) @db.Decimal(10, 2)
  total          Decimal        @db.Decimal(10, 2)
  customerNote   String?
  billPrintedAt  DateTime?
  paymentMethod  PaymentMethod?
  paymentNote    String?
  /// When paymentMethod=PART: [{ method, amount, note? }]
  paymentSplits  Json?
  /// Optional guest staff appreciation (not part of bill total)
  staffAppreciationAmount Decimal @default(0) @db.Decimal(10, 2)
  paidAt         DateTime?
  /// Set when status becomes CANCELLED (admin cancel with reason + password)
  cancelReason       String?
  cancelledAt        DateTime?
  cancelledByUserId  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table      DiningTable  @relation(fields: [tableId], references: [id], onDelete: Restrict)
  session    Session?     @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  cancelledBy User?       @relation("OrderCancellations", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  items      OrderItem[]
  appreciationShares OrderAppreciationShare[]

  @@index([restaurantId, createdAt])
  @@index([restaurantId, status])
  @@index([status])
  @@index([tableId])
  @@index([sessionId])
  @@index([orderNumber])
  @@index([restaurantId, paymentMethod])
  @@index([cancelledByUserId])
}

/// Per-captain share of staff appreciation collected on a settled bill.
model OrderAppreciationShare {
  id            String   @id @default(cuid())
  orderId       String
  captainUserId String
  amount        Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())

  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  captain User  @relation(fields: [captainUserId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([captainUserId, createdAt])
  @@unique([orderId, captainUserId])
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  dishId           String?
  dishNameSnapshot String
  priceSnapshot    Decimal @db.Decimal(10, 2)
  quantity         Int
  subtotal         Decimal @db.Decimal(10, 2)
  imageUrl         String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dish  Dish? @relation(fields: [dishId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([dishId])
}

model Menu {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  description  String?
  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categories Category[]

  @@index([restaurantId])
}

model Category {
  id           String   @id @default(cuid())
  menuId       String
  name         String
  description  String?
  displayOrder Int      @default(0)
  isEnabled    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  menu            Menu             @relation(fields: [menuId], references: [id], onDelete: Cascade)
  dishes          Dish[]
  analyticsEvents AnalyticsEvent[]

  @@index([menuId])
  @@index([menuId, displayOrder])
}

model Dish {
  id           String   @id @default(cuid())
  categoryId   String
  name         String
  description  String
  price        Decimal  @db.Decimal(10, 2)
  imageUrl     String?
  ingredients  String[]
  dietaryTags  String[]
  displayOrder Int      @default(0)
  isAvailable  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category        Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  analyticsEvents AnalyticsEvent[]
  orderItems      OrderItem[]

  @@index([categoryId])
}

model Session {
  id                 String    @id @default(cuid())
  restaurantId       String
  anonymousSessionId String
  tableId            String?
  startedAt          DateTime  @default(now())
  endedAt            DateTime?

  restaurant      Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table           DiningTable?     @relation(fields: [tableId], references: [id], onDelete: SetNull)
  analyticsEvents AnalyticsEvent[]
  orders          Order[]

  @@unique([restaurantId, anonymousSessionId])
  @@index([restaurantId])
  @@index([anonymousSessionId])
  @@index([tableId])
}

model AnalyticsEvent {
  id            String   @id @default(cuid())
  sessionId     String
  restaurantId  String
  eventType     String
  categoryId    String?
  dishId        String?
  /// Client-generated idempotency key (UUID). Retries / StrictMode double-posts skip duplicates.
  clientEventId String?  @unique
  metadata      Json?
  timestamp     DateTime @default(now())

  session    Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category   Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  dish       Dish?       @relation(fields: [dishId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([sessionId])
  @@index([categoryId])
  @@index([dishId])
  @@index([eventType])
  @@index([timestamp])
  @@index([restaurantId, eventType, timestamp])
  @@index([restaurantId, categoryId, eventType])
  @@index([restaurantId, dishId, eventType])
}
